{% macro moved(parameters) -%}
{% for pid, old, new in parameters %}`{{ pid }}` {{ number(old) }} → {{ number(new) }}{{ ", " if not loop.last }}{% endfor %}
{%- endmacro %}
{% macro names(items) -%}
{% for item in items %}`{{ item }}`{{ ", " if not loop.last }}{% endfor %}
{%- endmacro %}
