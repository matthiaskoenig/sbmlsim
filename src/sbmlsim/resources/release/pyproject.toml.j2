[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = {{ repo_name | toml }}
version = {{ version | toml }}
description = {{ settings.description | toml }}
readme = "README.md"
requires-python = {{ requires_python | toml }}
authors = [
{% for author in settings.authors %}
    { name = {{ author.name | toml }} },
{% endfor %}
]
keywords = [
{% for keyword in settings.keywords %}
    {{ keyword | toml }},
{% endfor %}
]
classifiers = [
{% for version in pythons %}
    "Programming Language :: Python :: {{ version }}",
{% endfor %}
]
dependencies = [
{% for dependency in dependencies %}
    {{ dependency | toml }},
{% endfor %}
]

[project.urls]
Homepage = "https://github.com/{{ settings.repository }}"
Repository = "https://github.com/{{ settings.repository }}"
Documentation = {{ settings.site_url | toml }}
Issues = "https://github.com/{{ settings.repository }}/issues"

[dependency-groups]
docs = ["zensical"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ top_package }}"]

[tool.uv]
constraint-dependencies = [
{% for constraint in constraints %}
    {{ constraint | toml }},
{% endfor %}
]
{% if framework_path or indexes %}

[tool.uv.sources]
{% if framework_path %}
{{ framework }} = { path = {{ framework_path | toml }}, editable = true }
{% endif %}
{% for index in indexes %}
{% for package in index.packages %}
{{ package }} = { index = {{ index.name | toml }} }
{% endfor %}
{% endfor %}
{% endif %}
{% for index in indexes %}

[[tool.uv.index]]
name = {{ index.name | toml }}
url = {{ index.url | toml }}
explicit = true
{% endfor %}
